# Claves. El .env real vive FUERA del arbol del repositorio.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# Modelos
MODELO_SUPERVISOR=
MODELO_INVESTIGADOR=
MODELO_REDACTOR=
MODELO_EMBEDDINGS=
MODELO_ADMISION=
TEMPERATURA=
DIMENSIONES_EMBEDDINGS=

# Donde viven los datos. En Railway, sobre el volumen montado en /datos.
NOMBRE_COLECCION=
DIRECTORIO_INDICE=
DIRECTORIO_CACHE=
ARCHIVO_ESTADO=
INDICE_URL=
INDICE_HUELLA=

# Limites del servicio
CONSULTAS_POR_VISITANTE=
CONSULTAS_POR_IP=
CONSULTAS_POR_DIA=
INTENTOS_POR_VISITANTE=
CONSULTAS_CONCURRENTES=
PRESUPUESTO_USD_MES=
UMBRAL_SIMILITUD=
# Obligatoria: sin ella el servicio no arranca. Los cupos guardan sha256(sal | cookie) y
# sha256(sal | ip), y una sal corta o conocida deja esos hashes reversibles a la IP real.
# Genera la tuya y no la compartas entre despliegues:
#   python -c "import secrets; print(secrets.token_hex(32))"
SAL_VISITANTE=
ORIGEN_PERMITIDO=
# Sin esto, /respaldo no existe (404). Detras hay doce meses de texto de consultas, asi que va
# largo y propio de este despliegue:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_RESPALDO=

# Observabilidad
LANGSMITH_API_KEY=
PROYECTO_LANGSMITH=
